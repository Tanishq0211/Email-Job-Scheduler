{
  "name": "@reachinbox/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:migrate": "node scripts/run-with-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node scripts/run-with-env.mjs prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/run-with-env.mjs tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "node scripts/run-with-env.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.0",
    "@bull-board/express": "^6.7.0",
    "@elastic/elasticsearch": "^8.15.0",
    "@prisma/client": "^6.5.0",
    "@reachinbox/shared": "*",
    "@slack/web-api": "^7.8.0",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/papaparse": "^5.3.14",
    "@types/supertest": "^6.0.2",
    "papaparse": "^5.4.1",
    "pino-pretty": "^11.2.2",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
