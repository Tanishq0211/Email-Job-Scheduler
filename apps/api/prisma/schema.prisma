// ReachInbox Email Scheduler — Prisma schema
// PostgreSQL is the source of truth for business state.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    Session[]
  senders     Sender[]
  emails      Email[]
  slackConnec SlackConnection?
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Sender {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  email       String
  displayName String
  hourlyLimit Int      @default(200)
  minDelayMs  Int      @default(2000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@unique([userId, email])
  @@index([userId])
}

model Email {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  senderId    String      @db.Uuid
  recipient   String
  subject     String
  body        String
  // Effective per-campaign hourly cap: min(sender cap, requested cap).
  // Enforced by the worker's Redis rate limiter for this email.
  hourlyLimit Int      @default(200)
  scheduledAt DateTime
  sentAt      DateTime?
  failedAt    DateTime?
  status      String      @default("scheduled")
  attempts    Int         @default(0)
  bullJobId   String?     @unique
  messageId   String?
  previewUrl  String?
  lastError   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id])

  @@index([userId, status])
  @@index([userId, scheduledAt])
  @@index([senderId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([recipient])
  @@index([sentAt])
}

model SlackConnection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  teamId      String
  teamName    String
  accessToken String // encrypted at rest (AES-256-GCM)
  webhookUrl  String? // encrypted at rest
  channelId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
