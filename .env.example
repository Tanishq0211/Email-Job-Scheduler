# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# ── Data stores ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ── Secrets (generate: openssl rand -hex 32) ───────────────────────────
SESSION_SECRET=
APP_ENCRYPTION_KEY=

# ── Cookies ────────────────────────────────────────────────────────────
COOKIE_SECURE=false

# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── Slack OAuth (https://api.slack.com/apps) — optional feature ────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# ── SMTP (Ethereal — create at https://ethereal.email) ─────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── Scheduling / rate limiting ─────────────────────────────────────────
WORKER_CONCURRENCY=10
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_RECIPIENTS_PER_REQUEST=5000
